  "entries": [
    {
      "id": "年柱",
      "category": "宫位",
      "subject": "年柱",
      "citation": "三命通会",
      "tags": [
        "年柱",
        "宫位",
        "六亲"
      ],
      "attributes": {
        "宫位": "祖宗、先天根基、家族背景、早年运势（0-15岁）",
        "六亲": "年干为祖父，年支为祖母（男命）；女命年干为祖父，年支为祖母",
        "断法": "年柱有财则祖上有财，有印则书香门第，有杀则有官职背景"
      }
    },
    {
      "id": "月柱",
      "category": "宫位",
      "subject": "月柱",
      "citation": "三命通会",
      "tags": [
        "月柱",
        "宫位",
        "六亲"
      ],
      "attributes": {
        "宫位": "父母兄弟、工作事业、中年运（15-35岁），月令为格局之本",
        "六亲": "月干为父（男命）、兄弟；月支为母（含义丰富）",
        "断法": "月柱最重要，格局取用皆看月令，月支为命主之胎元所在"
      }
    },
    {
      "id": "日柱",
      "category": "宫位",
      "subject": "日柱",
      "citation": "三命通会",
      "tags": [
        "日柱",
        "宫位",
        "六亲"
      ],
      "attributes": {
        "宫位": "本人、婚姻宫、夫妻关系（日支为配偶宫），中年运（35-50岁）",
        "六亲": "日干为命主自身，日支为配偶宫",
        "断法": "日支旺相则婚姻稳固，日支受冲刑则婚姻动荡"
      }
    },
    {
      "id": "时柱",
      "category": "宫位",
      "subject": "时柱",
      "citation": "三命通会",
      "tags": [
        "时柱",
        "宫位",
        "六亲"
      ],
      "attributes": {
        "宫位": "子女、晚年运（50岁以后）、晚景",
        "六亲": "时干为长子，时支为子女",
        "断法": "时柱有子孙星旺则子女多且孝顺，时柱受克则晚年孤苦"
      }
    },
    {
      "id": "六亲_父母",
      "category": "六亲",
      "subject": "父母",
      "quotation": "正印偏印为母，正财偏财为父（男命）；年柱为祖辈宫位",
      "citation": "三命通会",
      "tags": [
        "父母",
        "六亲"
      ],
      "attributes": {}
    },
    {
      "id": "六亲_配偶",
      "category": "六亲",
      "subject": "配偶",
      "quotation": "男命正财为妻，偏财为妾/外遇；女命正官为夫，七杀为情人。日支为配偶宫",
      "citation": "三命通会",
      "tags": [
        "配偶",
        "六亲"
      ],
      "attributes": {}
    },
    {
      "id": "六亲_子女",
      "category": "六亲",
      "subject": "子女",
      "quotation": "男命食神伤官为子女；女命官杀为子女。时柱为子女宫",
      "citation": "三命通会",
      "tags": [
        "子女",
        "六亲"
      ],
      "attributes": {}
    },
    {
      "id": "六亲_兄弟",
      "category": "六亲",
      "subject": "兄弟",
      "quotation": "比肩劫财为兄弟姐妹，月柱为兄弟宫",
      "citation": "三命通会",
      "tags": [
        "兄弟",
        "六亲"
      ],
      "attributes": {}
    },
    {
      "id": "六亲_财运",
      "category": "六亲",
      "subject": "财运",
      "quotation": "正财偏财代表财富，财旺身强则富，财多身弱则为财所累",
      "citation": "三命通会",
      "tags": [
        "财运",
        "六亲"
      ],
      "attributes": {}
    },
    {
      "id": "六亲_官运",
      "category": "六亲",
      "subject": "官运",
      "quotation": "正官七杀代表权威地位，官旺印绶护身则贵，官杀混杂则纷扰",
      "citation": "三命通会",
      "tags": [
        "官运",
        "六亲"
      ],
      "attributes": {}
    },
    {
      "id": "运年_起大运",
      "category": "运年",
      "subject": "起大运",
      "quotation": "月柱干支顺行或逆行（男阳年、女阴年顺行，反之逆行），以节气间距除3为年数",
      "citation": "三命通会",
      "tags": [
        "起大运",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "运年_大运优先",
      "category": "运年",
      "subject": "大运优先",
      "quotation": "大运定格局高低，流年触发吉凶。大运行忌神之地多坎坷，行喜神之地多顺遂",
      "citation": "三命通会",
      "tags": [
        "大运优先",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "运年_太岁并冲",
      "category": "运年",
      "subject": "太岁并冲",
      "quotation": "流年太岁冲克日主，主有变动。太岁合日主，主有贵人",
      "citation": "三命通会",
      "tags": [
        "太岁并冲",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "运年_伏吟",
      "category": "运年",
      "subject": "伏吟",
      "quotation": "大运或流年干支与命局相同，谓之伏吟，主是非口舌，原地踏步",
      "citation": "三命通会",
      "tags": [
        "伏吟",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "运年_反吟",
      "category": "运年",
      "subject": "反吟",
      "quotation": "大运或流年干支与命局六冲，谓之反吟，主动荡变故",
      "citation": "三命通会",
      "tags": [
        "反吟",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "运年_喜用神运",
      "category": "运年",
      "subject": "喜用神运",
      "quotation": "大运流年逢喜用神旺地，吉事应验",
      "citation": "三命通会",
      "tags": [
        "喜用神运",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "运年_忌仇神运",
      "category": "运年",
      "subject": "忌仇神运",
      "quotation": "大运流年逢忌仇神旺地，凶事应期",
      "citation": "三命通会",
      "tags": [
        "忌仇神运",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "运年_三命通会论运",
      "category": "运年",
      "subject": "三命通会论运",
      "quotation": "运之祸福，须按命局五行强弱，逢生旺则发，逢克制则退",
      "citation": "三命通会",
      "tags": [
        "三命通会论运",
        "大运",
        "流年"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_得令",
      "category": "强弱",
      "subject": "得令",
      "quotation": "月支生扶日主（旺/相），为得令得势，是身强基础",
      "citation": "三命通会/滴天髓",
      "tags": [
        "得令",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_得地",
      "category": "强弱",
      "subject": "得地",
      "quotation": "地支有三处以上比劫/印绶通根，为得地",
      "citation": "三命通会/滴天髓",
      "tags": [
        "得地",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_得势",
      "category": "强弱",
      "subject": "得势",
      "quotation": "天干比劫印绶数量多于财官食伤，为得势",
      "citation": "三命通会/滴天髓",
      "tags": [
        "得势",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_身强条件",
      "category": "强弱",
      "subject": "身强条件",
      "quotation": "得令且得地，或得地且得势（比劫印多于财官食伤）",
      "citation": "三命通会/滴天髓",
      "tags": [
        "身强条件",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_身弱条件",
      "category": "强弱",
      "subject": "身弱条件",
      "quotation": "失令且无得地，或财官食伤远多于比劫印绶",
      "citation": "三命通会/滴天髓",
      "tags": [
        "身弱条件",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_中和",
      "category": "强弱",
      "subject": "中和",
      "quotation": "强弱难分，不明显偏向任何一方，论平衡",
      "citation": "三命通会/滴天髓",
      "tags": [
        "中和",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_旺极从势",
      "category": "强弱",
      "subject": "旺极从势",
      "quotation": "日主孤立无根，全局一种五行极旺，从之为宜",
      "citation": "三命通会/滴天髓",
      "tags": [
        "旺极从势",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_中和论",
      "category": "强弱",
      "subject": "中和论",
      "quotation": "有病方为贵，无伤不是奇——《滴天髓》。命贵中和，偏枯终于有损",
      "citation": "三命通会/滴天髓",
      "tags": [
        "中和论",
        "强弱"
      ],
      "attributes": {}
    },
    {
      "id": "强弱_调候优先",
      "category": "强弱",
      "subject": "调候优先",
      "quotation": "若命局严重偏寒或偏热，调候用神优先于格局用神——《穷通宝鉴》",
      "citation": "三命通会/滴天髓",
      "tags": [
        "调候优先",
        "强弱"
      ],
      "attributes": {}
    }
  ]
